VITE_API_URL=http://127.0.0.1:8000
VITE_GOOGLE_CLIENT_ID=
# Must match Authorized redirect URIs on the Google Cloud web OAuth client
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/auth-callback

# Shown on the Privacy/Terms pages, Billing and Settings. Required for staging/production builds.
VITE_SUPPORT_EMAIL=support@yourdomain.com
# Legal entity name used on the Privacy/Terms pages.
VITE_COMPANY_NAME=Admart
